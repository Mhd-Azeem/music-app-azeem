# Copy this file to "local.properties" (which is git-ignored) and fill in your values.
# The Android SDK location is normally added here automatically by Android Studio.
sdk.dir=/path/to/your/Android/sdk

# Base URL of your own self-hosted https://github.com/sumitkolhe/jiosaavn-api deployment
# (e.g. a free Vercel deployment). Must end with /api/. This is the app's only music source —
# leave it unset and search/browse just come back empty (handled gracefully, not a crash).
JIOSAAVN_BASE_URL=https://your-deployment.vercel.app/api/
