# Copy this file to "local.properties" (which is git-ignored) and fill in your values.
# The Android SDK location is normally added here automatically by Android Studio.
sdk.dir=/path/to/your/Android/sdk

# Base URL of a https://github.com/sumitkolhe/jiosaavn-api deployment. Must end with /api/.
# This is the app's only music source. Defaults (in app/build.gradle.kts) to this project's
# own Cloudflare Workers deployment, so you only need to set this if you deploy your own instance.
JIOSAAVN_BASE_URL=https://jiosaavn-api.azeemzahira111.workers.dev/api/
