<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wavelength" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Wavelength.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#140B2D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_classic</item>
        <item name="windowSplashScreenIconBackgroundColor">#5E35B1</item>
        <item name="postSplashScreenTheme">@style/Theme.Wavelength</item>
    </style>
</resources>
